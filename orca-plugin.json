{
  "manifestVersion": 2,
  "id": "binary-tools",
  "publisher": "be0hhh",
  "name": "Binary & Assembly Tools",
  "version": "1.1.4",
  "execution": "sandboxed-ui",
  "description": "Native-style binary inspection for ELF, PE/COFF and AR archives: searchable symbols, section sizes, hex, strings and Assembly highlighting.",
  "cover": {
    "path": "assets/cover.jpg",
    "alt": "Binary & Assembly Tools"
  },
  "license": "MIT",
  "repository": "https://github.com/be0hhh/orca-binary-tools",
  "engines": {
    "orca": ">=1.4.245"
  },
  "contributes": {
    "syntaxes": [
      {
        "id": "asm-x86",
        "title": "Assembly (x86 / x86_64)",
        "scopeName": "source.asm.x86",
        "path": "syntaxes/x86.tmLanguage.json",
        "configuration": "syntaxes/x86-configuration.json",
        "extensions": [".asm", ".inc"],
        "filenames": []
      },
      {
        "id": "asm-arm",
        "title": "Assembly (ARM / AArch64)",
        "scopeName": "source.asm.arm",
        "path": "syntaxes/arm.tmLanguage.json",
        "configuration": "syntaxes/arm-configuration.json",
        "extensions": [".arm", ".a64"],
        "filenames": []
      },
      {
        "id": "asm-generic",
        "title": "Assembly (GAS / AT&T)",
        "scopeName": "source.asm",
        "path": "syntaxes/generic.tmLanguage.json",
        "configuration": "syntaxes/gas-configuration.json",
        "extensions": [".s"],
        "filenames": []
      }
    ],
    "customEditors": [
      {
        "id": "binary-inspector",
        "title": "Binary Inspector",
        "extensions": [
          ".o",
          ".obj",
          ".a",
          ".lib",
          ".so",
          ".dylib",
          ".dll",
          ".exe",
          ".bin",
          ".elf",
          ".out"
        ],
        "entry": "editor/index.html",
        "priority": "default",
        "contentKind": "bytes"
      }
    ],
    "newFiles": [
      {
        "id": "binary-inspection",
        "title": "New binary inspection",
        "extension": ".bin"
      },
      {
        "id": "example-intel",
        "title": "New Intel assembly example",
        "extension": ".asm",
        "template": "samples/hello_x86_intel.asm"
      },
      {
        "id": "example-att",
        "title": "New AT&T assembly example",
        "extension": ".s",
        "template": "samples/hello_x86_att.s"
      },
      {
        "id": "example-arm",
        "title": "New ARM assembly example",
        "extension": ".arm",
        "template": "samples/hello_arm.s"
      }
    ]
  },
  "capabilities": []
}
