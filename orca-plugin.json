{
  "manifestVersion": 2,
  "id": "lowlevel-tools",
  "publisher": "be0hhh",
  "name": "Assembly & Binary Tools",
  "version": "0.3.0",
  "execution": "sandboxed-ui",
  "description": "Native & low-level development toolkit: assembly (x86, ARM, GAS) and C++ inline/template (.ipp, .inl, .tpp) syntax highlighting, plus interactive Binary Inspector & Hex Viewer for .o and .a files.",
  "license": "MIT",
  "repository": "https://github.com/be0hhh/orca-lowlevel-tools",
  "engines": {
    "orca": ">=1.4.248"
  },
  "contributes": {
    "syntaxes": [
      {
        "id": "asm-x86",
        "title": "x86 Assembly",
        "scopeName": "source.asm.x86",
        "path": "syntaxes/x86.tmLanguage.json",
        "configuration": "syntaxes/x86-configuration.json",
        "extensions": [
          ".asm"
        ]
      },
      {
        "id": "asm-arm",
        "title": "ARM Assembly",
        "scopeName": "source.asm.arm",
        "path": "syntaxes/arm.tmLanguage.json",
        "configuration": "syntaxes/arm-configuration.json",
        "extensions": []
      },
      {
        "id": "asm-generic",
        "title": "Assembly",
        "scopeName": "source.asm",
        "path": "syntaxes/generic.tmLanguage.json",
        "configuration": "syntaxes/gas-configuration.json",
        "extensions": [
          ".s",
          ".S"
        ]
      },
      {
        "id": "cpp-inlines",
        "title": "C++ Inlines & Templates",
        "scopeName": "source.cpp.inlines",
        "path": "syntaxes/cpp.tmLanguage.json",
        "configuration": "syntaxes/cpp-configuration.json",
        "extensions": [
          ".ipp",
          ".inl",
          ".tpp"
        ]
      }
    ],
    "customEditors": [
      {
        "id": "binary-inspector",
        "title": "Binary Inspector",
        "extensions": [
          ".o",
          ".a",
          ".bin",
          ".elf",
          ".so",
          ".dylib"
        ],
        "entry": "editor/index.html",
        "priority": "default",
        "contentKind": "bytes"
      }
    ]
  },
  "capabilities": []
}
